---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero/seated.jpg";
import backPhoto from "../assets/hero/back-physique.jpg";
import physiquePhoto from "../assets/hero/front-physique.jpg";
import membersPhoto from "../assets/hero/members.webp";
import Icon from "./Icon.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import DirectionsLink from "./DirectionsLink.astro";
import { siteConfig } from "../config/site";
const heroPhotos = [
  {
    image: heroPhoto,
    alt: `${siteConfig.featuredTrainer.name} seated beside strength training equipment at SHAN FITNESS`,
    position: "50% 46%",
  },
  {
    image: backPhoto,
    alt: `${siteConfig.featuredTrainer.name} showing his back physique at SHAN FITNESS`,
    position: "50% 45%",
  },
  {
    image: physiquePhoto,
    alt: `${siteConfig.featuredTrainer.name} showing his physique at SHAN FITNESS`,
    position: "50% 40%",
  },
  {
    image: membersPhoto,
    alt: "Two gym members posing beside strength training equipment at SHAN FITNESS",
    position: "50% 35%",
  },
];
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="hero-intro">Personal coaching. Real consistency.</p>
    <h1 id="hero-heading"><span>TRAIN WITH</span><span>PURPOSE.</span></h1>
    <p class="hero-description">
      Your goals. Your pace. A plan built around you.<br
        class="desktop-break"
      /> Personal training and guidance for the work that matters.
    </p>
    <div class="hero-actions">
      <WhatsAppButton /><a class="text-link" href="#training"
        >Explore training <Icon name="down" size={18} /></a
      >
    </div>
    <div class="hero-location">
      <Icon name="pin" size={20} /><span
        >South Trippanachi, Pulpatta<br /><strong>Malappuram, Kerala</strong
        ></span
      >
      <DirectionsLink />
    </div>
  </div>
  <figure
    class="hero-visual"
    data-hero-gallery
    aria-label="SHAN FITNESS photo gallery"
  >
    <div class="hero-photo-wrap">
      {
        heroPhotos.map((photo, index) => (
          <div
            class:list={["hero-slide", { "is-active": index === 0 }]}
            aria-hidden={index !== 0}
          >
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 900px) 48vw, 100vw"
              format="webp"
              quality={88}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              class="hero-photo"
              style={`object-position: ${photo.position}`}
            />
          </div>
        ))
      }
    </div>
    <div class="hero-photo-top">
      <span class="photo-dot" aria-hidden="true"></span>SHAN FITNESS / PULPATTA
    </div>
    <figcaption class="hero-caption">
      <span>Build strength.<br />Build consistency.</span><a
        href="#trainers"
        aria-label="Meet our trainers"><Icon name="diagonal" size={28} /></a
      >
    </figcaption>
    <div class="hero-gallery-controls" hidden>
      <div class="hero-dots" aria-label="Choose a photo">
        {
          heroPhotos.map((_, index) => (
            <button
              type="button"
              class="hero-dot"
              data-slide={index}
              aria-label={`Show photo ${index + 1} of ${heroPhotos.length}`}
              aria-pressed={index === 0}
            >
              <span />
            </button>
          ))
        }
      </div>
    </div>
    <div class="hero-visual-edge" aria-hidden="true"></div>
  </figure>
</section>
<div class="training-band" aria-label="In-person and online personal coaching">
  <div class="container training-band-inner">
    <span>PERSONAL TRAINING</span><span class="band-cross" aria-hidden="true"
      >+</span
    ><span>ONLINE COACHING</span><span class="band-cross" aria-hidden="true"
      >+</span
    ><span>A PLAN FOR YOU</span>
  </div>
</div>
<script>
  const gallery = document.querySelector<HTMLElement>("[data-hero-gallery]");
  if (gallery) {
    const slides = Array.from(
      gallery.querySelectorAll<HTMLElement>(".hero-slide"),
    );
    const controls = gallery.querySelector<HTMLElement>(
      ".hero-gallery-controls",
    );
    const dots = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>(".hero-dot"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // The phone layout can show less than half the photo on first arrival.
    const visibleThreshold = 0.2;
    let active = 0;
    let visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const schedule = () => {
      clearTimeout(timer);
      if (visible && !document.hidden && !reducedMotion.matches) {
        timer = setTimeout(() => show(active + 1), 6500);
      }
    };
    const show = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === active);
        slide.setAttribute("aria-hidden", String(i !== active));
        dots[i]?.setAttribute("aria-pressed", String(i === active));
      });
      schedule();
    };
    if (controls) controls.hidden = false;
    dots.forEach((dot, index) =>
      dot.addEventListener("click", () => show(index)),
    );
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        show(active + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    document.addEventListener("visibilitychange", schedule);
    reducedMotion.addEventListener("change", schedule);
    new IntersectionObserver(
      ([entry]) => {
        visible = (entry?.intersectionRatio ?? 0) >= visibleThreshold;
        schedule();
      },
      { threshold: visibleThreshold },
    ).observe(gallery);
    schedule();
  }
</script>
